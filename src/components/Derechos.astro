---
import "../styles/global.css";
---

<div class="relative min-h-screen overflow-hidden bg-gradient-to-br from-purple-50 via-white to-pink-50">

  <!-- =========================================
       DECORACIÓN DE FONDO
  ========================================== -->

  <div
    class="pointer-events-none absolute -left-32 top-20 h-80 w-80 rounded-full bg-purple-300/40 blur-3xl"
  ></div>

  <div
    class="pointer-events-none absolute -right-32 top-[35%] h-96 w-96 rounded-full bg-pink-300/40 blur-3xl"
  ></div>

  <div
    class="pointer-events-none absolute bottom-[25%] left-1/3 h-72 w-72 rounded-full bg-yellow-200/50 blur-3xl"
  ></div>

  <div
    class="pointer-events-none absolute right-1/4 top-10 h-40 w-40 rounded-full bg-blue-200/30 blur-3xl"
  ></div>


  <!-- =========================================
       CONTENIDO
  ========================================== -->

  <main class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

    <!-- VOLVER -->

    <div class="pt-8">

      <a
        href="/"
        class="group inline-flex items-center gap-2 rounded-full border border-purple-100 bg-white/90 px-5 py-2.5 text-sm font-bold text-purple-700 shadow-md backdrop-blur transition-all duration-300 hover:-translate-x-1 hover:bg-purple-50 hover:shadow-lg"
      >
        <span>←</span>
        Volver al inicio
      </a>

    </div>


    <!-- =========================================
         HERO
    ========================================== -->

    <header class="mx-auto max-w-4xl py-16 text-center md:py-20">

      <span
        class="inline-flex rounded-full bg-purple-100 px-4 py-2 text-xs font-black uppercase tracking-wider text-purple-700 shadow-sm"
      >
        💜 Tus derechos importan
      </span>

      <h1
        class="mt-6 text-4xl font-black tracking-tight text-purple-800 sm:text-5xl md:text-6xl"
      >
        Conoce tus derechos
        <span class="text-pink-500"> y aprende a protegerte</span>
      </h1>

      <p
        class="mx-auto mt-6 max-w-2xl text-base leading-8 text-gray-600 sm:text-lg"
      >
        Todas las personas tienen derecho a sentirse seguras,
        ser respetadas, expresar lo que sienten y pedir ayuda
        cuando algo no está bien.
      </p>

      <div class="mt-8 flex flex-wrap justify-center gap-3">

        <a
          href="#conoce"
          class="rounded-full bg-purple-700 px-6 py-3 font-bold text-white shadow-lg transition hover:-translate-y-1 hover:bg-purple-800"
        >
          Conocer mis derechos ↓
        </a>

        <a
          href="#ayuda"
          class="rounded-full border border-purple-200 bg-white px-6 py-3 font-bold text-purple-700 shadow-sm transition hover:-translate-y-1 hover:bg-purple-50"
        >
          ¿Necesito ayuda?
        </a>

      </div>

    </header>


    <!-- =========================================
         DERECHOS PRINCIPALES
    ========================================== -->

    <section id="conoce" class="scroll-mt-10 pb-20">

      <div class="mb-10 text-center">

        <span class="text-xs font-black uppercase tracking-[0.2em] text-pink-500">
          Lo que debes saber
        </span>

        <h2 class="mt-3 text-3xl font-black text-purple-800 md:text-4xl">
          Tienes derecho a...
        </h2>

        <p class="mx-auto mt-4 max-w-2xl leading-7 text-gray-600">
          Conocer tus derechos te ayuda a reconocer cuándo una situación
          es adecuada y cuándo necesitas pedir apoyo.
        </p>

      </div>


      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">

        <!-- DERECHO 1 -->

        <article
          class="group rounded-[2rem] border border-purple-100 bg-white/90 p-7 shadow-lg shadow-purple-100/40 backdrop-blur transition duration-300 hover:-translate-y-2 hover:shadow-xl"
        >

          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-purple-100 text-3xl transition group-hover:scale-110"
          >
            🛡️
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Derecho a estar seguro/a
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Nadie debería hacerte daño, amenazarte, humillarte
            o hacerte sentir que estás en peligro.
          </p>

        </article>


        <!-- DERECHO 2 -->

        <article
          class="group rounded-[2rem] border border-pink-100 bg-white/90 p-7 shadow-lg shadow-pink-100/40 backdrop-blur transition duration-300 hover:-translate-y-2 hover:shadow-xl"
        >

          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-pink-100 text-3xl transition group-hover:scale-110"
          >
            🗣️
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Derecho a ser escuchado/a
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Tus sentimientos, preocupaciones y opiniones merecen
            ser escuchados con respeto.
          </p>

        </article>


        <!-- DERECHO 3 -->

        <article
          class="group rounded-[2rem] border border-yellow-100 bg-white/90 p-7 shadow-lg shadow-yellow-100/40 backdrop-blur transition duration-300 hover:-translate-y-2 hover:shadow-xl"
        >

          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-yellow-100 text-3xl transition group-hover:scale-110"
          >
            ✋
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Derecho a decir NO
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Puedes poner límites y expresar que algo te incomoda,
            incluso si otra persona insiste.
          </p>

        </article>


        <!-- DERECHO 4 -->

        <article
          class="group rounded-[2rem] border border-blue-100 bg-white/90 p-7 shadow-lg shadow-blue-100/40 backdrop-blur transition duration-300 hover:-translate-y-2 hover:shadow-xl"
        >

          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-100 text-3xl transition group-hover:scale-110"
          >
            ❤️
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Derecho al respeto
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Mereces recibir un trato digno, sin insultos,
            burlas, discriminación ni humillaciones.
          </p>

        </article>


        <!-- DERECHO 5 -->

        <article
          class="group rounded-[2rem] border border-green-100 bg-white/90 p-7 shadow-lg shadow-green-100/40 backdrop-blur transition duration-300 hover:-translate-y-2 hover:shadow-xl"
        >

          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-green-100 text-3xl transition group-hover:scale-110"
          >
            🤝
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Derecho a recibir ayuda
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Si algo te preocupa, puedes acudir a una persona
            adulta de confianza y pedir apoyo.
          </p>

        </article>


        <!-- DERECHO 6 -->

        <article
          class="group rounded-[2rem] border border-orange-100 bg-white/90 p-7 shadow-lg shadow-orange-100/40 backdrop-blur transition duration-300 hover:-translate-y-2 hover:shadow-xl"
        >

          <div
            class="flex h-14 w-14 items-center justify-center rounded-2xl bg-orange-100 text-3xl transition group-hover:scale-110"
          >
            🌱
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Derecho a crecer y aprender
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Tienes derecho a desarrollarte en un entorno que favorezca
            tu bienestar, aprendizaje y desarrollo.
          </p>

        </article>

      </div>

    </section>


    <!-- =========================================
         DERECHOS + ALERTAS
    ========================================== -->

    <section class="grid gap-8 pb-20 lg:grid-cols-2">

      <!-- DERECHOS -->

      <article
        class="group relative min-h-[420px] overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-purple-700 via-purple-700 to-purple-900 p-8 text-white shadow-xl shadow-purple-200/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl md:p-10"
      >

        <div
          class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-purple-400/30 blur-3xl transition-transform duration-700 group-hover:scale-125"
        ></div>

        <div class="relative z-10">

          <span
            class="inline-flex rounded-full bg-yellow-300 px-4 py-2 text-xs font-black uppercase tracking-wide text-[#443650]"
          >
            Para ti
          </span>

          <h2 class="mt-7 text-4xl font-black leading-tight md:text-5xl">
            Tu voz tiene valor
          </h2>

          <p class="mt-5 max-w-md text-base leading-7 text-purple-100 md:text-lg">
            Si algo te incomoda, puedes hablar. No tienes que guardar
            silencio ni enfrentarte a una situación difícil por tu cuenta.
          </p>

          <a
            href="#ayuda"
            class="mt-8 inline-flex rounded-full bg-yellow-300 px-6 py-3.5 font-bold text-[#443650] shadow-lg transition hover:-translate-y-1 hover:bg-yellow-400"
          >
            ¿Cómo pedir ayuda? →
          </a>

        </div>

        <div
          class="pointer-events-none absolute -bottom-8 right-2 text-[130px] opacity-90 transition-transform duration-500 group-hover:scale-110"
          aria-hidden="true"
        >
          🧒🏻
        </div>

      </article>


      <!-- ALERTAS -->

      <article
        id="alertas"
        class="group relative overflow-hidden rounded-[2.5rem] border border-blue-100 bg-white/90 p-8 shadow-xl shadow-blue-100/40 backdrop-blur transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl md:p-10"
      >

        <div
          class="pointer-events-none absolute -right-20 -top-20 h-56 w-56 rounded-full bg-pink-200/40 blur-3xl"
        ></div>

        <div class="relative z-10">

          <span class="text-xs font-black uppercase tracking-[0.15em] text-pink-500">
            Presta atención
          </span>

          <h2 class="mt-3 text-4xl font-black leading-tight text-purple-800">
            Señales de alerta
          </h2>

          <p class="mt-5 leading-7 text-gray-600">
            Algunas situaciones o cambios pueden indicar que necesitas
            hablar con alguien de confianza.
          </p>


          <div class="mt-8 grid gap-4 sm:grid-cols-2">

            <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">

              <div class="text-4xl">😟</div>

              <p class="mt-3 font-bold leading-6 text-gray-800">
                Cambios bruscos en el estado de ánimo.
              </p>

            </div>


            <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">

              <div class="text-4xl">🙅</div>

              <p class="mt-3 font-bold leading-6 text-gray-800">
                Aislamiento o evitar el contacto físico.
              </p>

            </div>


            <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">

              <div class="text-4xl">😨</div>

              <p class="mt-3 font-bold leading-6 text-gray-800">
                Sentir miedo constante ante una persona o situación.
              </p>

            </div>


            <div class="rounded-2xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-md">

              <div class="text-4xl">🤐</div>

              <p class="mt-3 font-bold leading-6 text-gray-800">
                Sentir que debes guardar un secreto que te hace daño.
              </p>

            </div>

          </div>

        </div>

      </article>

    </section>


    <!-- =========================================
         PONER LÍMITES
    ========================================== -->

    <section class="pb-20">

      <div
        class="relative overflow-hidden rounded-[2.5rem] bg-yellow-50 p-8 md:p-12"
      >

        <div
          class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-yellow-200/50 blur-3xl"
        ></div>

        <div class="relative z-10 grid gap-10 lg:grid-cols-2 lg:items-center">

          <div>

            <span class="text-xs font-black uppercase tracking-[0.2em] text-orange-500">
              Tus límites importan
            </span>

            <h2 class="mt-3 text-3xl font-black text-purple-800 md:text-4xl">
              Puedes decir “no”
            </h2>

            <p class="mt-5 leading-7 text-gray-600">
              Poner límites significa expresar lo que quieres o no quieres
              hacer. No necesitas sentirte culpable por proteger tu espacio,
              tu cuerpo o tus emociones.
            </p>

          </div>


          <div class="grid gap-4 sm:grid-cols-2">

            <div class="rounded-2xl bg-white p-5 shadow-sm">
              <div class="text-3xl">✋</div>
              <p class="mt-3 font-bold text-purple-800">
                “No quiero.”
              </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm">
              <div class="text-3xl">🗣️</div>
              <p class="mt-3 font-bold text-purple-800">
                “Esto me incomoda.”
              </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm">
              <div class="text-3xl">🚶</div>
              <p class="mt-3 font-bold text-purple-800">
                “Me voy a retirar.”
              </p>
            </div>

            <div class="rounded-2xl bg-white p-5 shadow-sm">
              <div class="text-3xl">🤝</div>
              <p class="mt-3 font-bold text-purple-800">
                “Necesito ayuda.”
              </p>
            </div>

          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         QUÉ HACER
    ========================================== -->

    <section
      id="prevencion"
      class="scroll-mt-10 pb-20"
    >

      <div class="mb-10 text-center">

        <span class="text-xs font-black uppercase tracking-[0.2em] text-blue-500">
          Si algo sucede
        </span>

        <h2 class="mt-3 text-3xl font-black text-purple-800 md:text-4xl">
          ¿Qué puedo hacer?
        </h2>

        <p class="mx-auto mt-4 max-w-2xl leading-7 text-gray-600">
          No tienes que resolver una situación difícil por tu cuenta.
          Estos pasos pueden ayudarte.
        </p>

      </div>


      <div class="grid gap-5 md:grid-cols-3">

        <article class="relative rounded-[2rem] bg-white p-7 shadow-lg shadow-blue-100/40">

          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-100 text-2xl font-black text-blue-700">
            1
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Aléjate si puedes
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Si una situación te hace sentir en peligro, busca un lugar
            seguro y acércate a otras personas.
          </p>

        </article>


        <article class="relative rounded-[2rem] bg-white p-7 shadow-lg shadow-pink-100/40">

          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-pink-100 text-2xl font-black text-pink-700">
            2
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Cuéntaselo a alguien
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Habla con una persona adulta de confianza y explica
            lo que está pasando.
          </p>

        </article>


        <article class="relative rounded-[2rem] bg-white p-7 shadow-lg shadow-purple-100/40">

          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-purple-100 text-2xl font-black text-purple-700">
            3
          </div>

          <h3 class="mt-5 text-xl font-black text-purple-800">
            Sigue pidiendo ayuda
          </h3>

          <p class="mt-3 leading-7 text-gray-600">
            Si la primera persona no te escucha, busca otra persona
            de confianza hasta encontrar el apoyo que necesitas.
          </p>

        </article>

      </div>

    </section>


    <!-- =========================================
         PERSONAS DE CONFIANZA
    ========================================== -->

    <section
      id="ayuda"
      class="scroll-mt-10 pb-20"
    >

      <div
        class="overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-blue-50 via-white to-purple-50 p-8 md:p-12"
      >

        <div class="text-center">

          <span class="text-xs font-black uppercase tracking-[0.2em] text-purple-500">
            No estás solo/a
          </span>

          <h2 class="mt-3 text-3xl font-black text-purple-800 md:text-4xl">
            ¿A quién puedo acudir?
          </h2>

          <p class="mx-auto mt-4 max-w-2xl leading-7 text-gray-600">
            Puedes elegir a una persona con quien te sientas seguro/a
            y que pueda escucharte y ayudarte.
          </p>

        </div>


        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

          <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
            <div class="text-4xl">👩‍🏫</div>
            <h3 class="mt-3 font-black text-purple-800">
              Docente
            </h3>
            <p class="mt-2 text-sm leading-6 text-gray-600">
              Una profesora, profesor u orientador/a.
            </p>
          </div>


          <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
            <div class="text-4xl">👨‍👩‍👧</div>
            <h3 class="mt-3 font-black text-purple-800">
              Familia
            </h3>
            <p class="mt-2 text-sm leading-6 text-gray-600">
              Un familiar adulto en quien confíes.
            </p>
          </div>


          <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
            <div class="text-4xl">🧑‍⚕️</div>
            <h3 class="mt-3 font-black text-purple-800">
              Profesional
            </h3>
            <p class="mt-2 text-sm leading-6 text-gray-600">
              Un profesional que pueda orientarte.
            </p>
          </div>


          <div class="rounded-2xl bg-white p-6 text-center shadow-sm">
            <div class="text-4xl">🤝</div>
            <h3 class="mt-3 font-black text-purple-800">
              Otra persona de confianza
            </h3>
            <p class="mt-2 text-sm leading-6 text-gray-600">
              Alguien que te escuche y respete.
            </p>
          </div>

        </div>

      </div>

    </section>


    <!-- =========================================
         RECORDATORIOS
    ========================================== -->

    <section class="pb-20">

      <div class="grid gap-5 md:grid-cols-3">

        <div class="rounded-[2rem] bg-purple-700 p-7 text-white shadow-lg">
          <div class="text-4xl">💜</div>

          <h3 class="mt-4 text-xl font-black">
            Tus sentimientos importan
          </h3>

          <p class="mt-3 leading-7 text-purple-100">
            Si algo te hace sentir incómodo/a o preocupado/a,
            merece ser tomado en serio.
          </p>
        </div>


        <div class="rounded-[2rem] bg-pink-500 p-7 text-white shadow-lg">
          <div class="text-4xl">🗣️</div>

          <h3 class="mt-4 text-xl font-black">
            Hablar está bien
          </h3>

          <p class="mt-3 leading-7 text-pink-100">
            Pedir ayuda no es una señal de debilidad.
            Es una forma de cuidarte.
          </p>
        </div>


        <div class="rounded-[2rem] bg-yellow-300 p-7 text-[#443650] shadow-lg">
          <div class="text-4xl">🌟</div>

          <h3 class="mt-4 text-xl font-black">
            Tú tienes valor
          </h3>

          <p class="mt-3 leading-7 text-[#5c4b20]">
            Mereces respeto, seguridad y personas que te apoyen.
          </p>
        </div>

      </div>

    </section>


    <!-- =========================================
         MENSAJE FINAL
    ========================================== -->

    <section class="relative mb-20 overflow-hidden rounded-[2.5rem] bg-gradient-to-r from-purple-700 via-purple-600 to-pink-500 p-8 text-center text-white shadow-xl md:p-14">

      <div
        class="pointer-events-none absolute -left-20 -top-20 h-56 w-56 rounded-full bg-white/10 blur-3xl"
      ></div>

      <div
        class="pointer-events-none absolute -bottom-20 -right-20 h-64 w-64 rounded-full bg-yellow-300/20 blur-3xl"
      ></div>

      <div class="relative z-10">

        <div class="text-5xl" aria-hidden="true">
          💜
        </div>

        <h2 class="mt-5 text-3xl font-black md:text-4xl">
          Recuerda: tu voz importa
        </h2>

        <p class="mx-auto mt-5 max-w-2xl leading-7 text-purple-100">
          Tienes derecho a estar seguro/a, ser respetado/a,
          expresar lo que sientes y pedir ayuda cuando la necesites.
        </p>

        <a
          href="#conoce"
          class="mt-8 inline-flex rounded-full bg-white px-7 py-3.5 font-bold text-purple-700 shadow-lg transition hover:-translate-y-1 hover:bg-purple-50"
        >
          Volver arriba ↑
        </a>

      </div>

    </section>

  </main>

</div>
